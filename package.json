{
  "name": "christmas-gesture-demo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "tsc -p tsconfig.tests.json && node --test .test-build/tests/*.test.js",
    "prepare:vision": "node scripts/prepare-vision.mjs",
    "postinstall": "npm run prepare:vision"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.2.3",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/three": "0.187.0",
    "eslint": "10.15.0",
    "globals": "^16.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "7.3.8"
  }
}
